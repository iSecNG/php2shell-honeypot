COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml

HP_PERSONA=wordpress
HP_SITE_TITLE=Example Logistics LLC
HP_SITE_TAGLINE=Logistics that just works.

HP_LOG=attacks
# DEBUG, INFO, WARNING, ERROR
HP_LOG_LEVEL=INFO
HP_FETCH_SAMPLES=1

# geolite or ipapi
HP_ENRICHER=geolite
# only for docker-compose.geoip.yml
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=
HP_IPAPI_KEY=

# discord
HP_NOTIFIERS=
HP_DISCORD_WEBHOOK_URL=
HP_DISCORD_COOLDOWN=600
HP_DISCORD_OTHER_EXPLOITS=0

HP_DOMAIN=example.com
HP_EXTRA_DOMAINS=www.example.com
ACME_EMAIL=you@example.org
ACME_STAGING=0
